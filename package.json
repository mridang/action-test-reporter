{
  "name": "@mridang/action-test-reporter",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "rollup --config=rollup.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "prepack": "tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --verbose --config=jest.config.mjs --runInBand",
    "test:debug": "jest --verbose --config=jest.config.mjs --runInBand --detectOpenHandles",
    "test:watch": "npm run test -- --watch"
  },
  "main": "dist/main.cjs",
  "exports": {
    ".": {
      "default": "./dist/main.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "keywords": [
    "github",
    "github-actions",
    "code-coverage",
    "test-reporter",
    "reporting",
    "summary",
    "clover",
    "cobertura",
    "jacoco",
    "lcov",
    "llvm-cov",
    "swift",
    "junit",
    "typescript"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "description": "A flexible GitHub Action that parses code coverage and test result files to generate beautiful, insightful summaries in your workflow.\n\n",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/action-test-reporter.git"
  },
  "homepage": "https://github.com/mridang/action-test-reporter",
  "bugs": "https://github.com/mridang/action-test-reporter/issues",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "fast-glob": "^3.3.3",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.2.0",
    "@mridang/eslint-defaults": "^2.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.1.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/xml2js": "^0.4.14",
    "eslint": "^10.14.0",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "rollup": "^4.68.0",
    "semantic-release": "^25.0.1",
    "semantic-release-major-tag": "^0.3.2",
    "ts-jest": "^29.4.0",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "@eslint/core": "1.2.1"
  }
}
